{
  "expo": {
    "name": "IShift",
    "slug": "shiftsnap",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/ishift-logo-light.png",
    "scheme": "shiftsnap",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/ishift-splash-light.png",
      "resizeMode": "contain",
      "backgroundColor": "#FBF7F3"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.shiftsnap.app",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSCameraUsageDescription": "IShift needs camera access to scan your work schedule",
        "NSPhotoLibraryUsageDescription": "IShift needs photo library access to select schedule images",
        "NSCalendarsFullAccessUsageDescription": "IShift needs access to your calendar to sync shift schedules",
        "ITSAppUsesNonExemptEncryption": false
      },
      "appleTeamId": "R9CKAABL8D"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/ishift-logo-light.png",
        "backgroundColor": "#FBF7F3"
      },
      "package": "com.shiftsnap.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/ishift-logo-light.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "IShift needs camera access to scan your work schedule"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "IShift needs photo library access to select schedule images",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#4A9DAD"
        }
      ],
      "expo-apple-authentication",
      "expo-web-browser",
      [
        "expo-calendar",
        {
          "calendarPermission": "IShift needs calendar access to sync your shift schedule"
        }
      ],
      "expo-font",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "abd14e6d-ee87-4a71-a31a-dec97ce3e3b2"
      }
    }
  }
}
